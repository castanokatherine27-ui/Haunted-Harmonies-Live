<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spooky Soundfest 2026 | Halloween Concert</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Inter:wght@300;400;600;800&family=Orbitron:wght@600;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pumpkin: '#ff6b00',
                        spookyGreen: '#00ff66',
                        ghostPurple: '#8b00ff',
                        hauntedDark: '#0a0512',
                        eerieSlate: '#150d22'
                    },
                    fontFamily: {
                        creepster: ['Creepster', 'cursive'],
                        orbitron: ['Orbitron', 'sans-serif'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0a0512;
            color: #f3f4f6;
            overflow-x: hidden;
            font-family: 'Inter', sans-serif;
        }

        .creepster-font {
            font-family: 'Creepster', cursive;
        }

        .orbitron-font {
            font-family: 'Orbitron', sans-serif;
        }

        /* Spooky Glowing Text Effects */
        .glow-orange {
            text-shadow: 0 0 10px #ff6b00, 0 0 20px #ff6b00, 0 0 40px #ff8800;
        }

        .glow-green {
            text-shadow: 0 0 10px #00ff66, 0 0 20px #00ff66;
        }

        .glow-purple {
            text-shadow: 0 0 10px #8b00ff, 0 0 25px #a855f7;
        }

        /* Card Container Styles */
        .spooky-card {
            background: linear-gradient(145deg, rgba(21, 13, 34, 0.9), rgba(12, 6, 20, 0.95));
            border: 1px solid rgba(255, 107, 0, 0.25);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .spooky-card:hover {
            border-color: rgba(255, 107, 0, 0.7);
            transform: translateY(-3px);
            box-shadow: 0 10px 30px -10px rgba(255, 107, 0, 0.4);
        }

        /* Custom Halloween Checkbox Styling */
        .spooky-checkbox-wrapper {
            position: relative;
            display: inline-block;
            width: 42px;
            height: 42px;
        }

        .spooky-checkbox-input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

        .spooky-checkbox-custom {
            position: absolute;
            top: 0;
            left: 0;
            width: 42px;
            height: 42px;
            background-color: rgba(30, 20, 45, 0.9);
            border: 2px solid #ff6b00;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .spooky-checkbox-custom i {
            color: #00ff66;
            font-size: 22px;
            transform: scale(0) rotate(-45deg);
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
        }

        .spooky-checkbox-input:checked + .spooky-checkbox-custom {
            background-color: rgba(0, 255, 102, 0.15);
            border-color: #00ff66;
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.5);
        }

        .spooky-checkbox-input:checked + .spooky-checkbox-custom i {
            transform: scale(1) rotate(0deg);
            opacity: 1;
        }

        /* Floating Animation */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }

        .floating {
            animation: float 5s ease-in-out infinite;
        }

        /* Fog canvas overlay */
        #fogCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            opacity: 0.35;
        }

        /* Counter Box Highlight */
        .counter-badge {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease, background-color 0.2s ease;
        }
        .counter-bump {
            transform: scale(1.35) rotate(5deg);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col relative selection:bg-pumpkin selection:text-black">

    <!-- Fog Background Canvas -->
    <canvas id="fogCanvas"></canvas>

    <!-- Header / Navigation Bar -->
    <header class="relative z-10 border-b border-pumpkin/20 bg-hauntedDark/80 backdrop-blur-md sticky top-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3 cursor-pointer" onclick="scrollToTop()">
                <i class="fa-solid fa-ghost text-3xl text-pumpkin animate-bounce"></i>
                <span class="creepster-font text-3xl sm:text-4xl text-pumpkin glow-orange tracking-wider">
                    SPOOKY SOUNDFEST
                </span>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold tracking-wide uppercase">
                <a href="#stages-section" class="hover:text-pumpkin transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-guitar text-xs"></i> Stage Selector
                </a>
                <a href="#lineup-section" class="hover:text-spookyGreen transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-skull text-xs"></i> Lineup
                </a>
                <a href="#passes-section" class="hover:text-ghostPurple transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-ticket text-xs"></i> Concert Pass
                </a>
            </nav>

            <div class="flex items-center gap-3">
                <!-- Sound FX Toggle Button -->
                <button id="soundToggleBtn" onclick="toggleAudio()" class="px-4 py-2 rounded-full border border-pumpkin/40 bg-pumpkin/10 hover:bg-pumpkin/20 text-pumpkin text-xs uppercase font-bold tracking-widest flex items-center gap-2 transition-all">
                    <i id="soundIcon" class="fa-solid fa-volume-xmark text-sm"></i>
                    <span id="soundText" class="hidden sm:inline">Spooky Sounds Off</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow relative z-10 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16">

        <!-- Hero Banner Section -->
        <section class="relative rounded-3xl overflow-hidden p-8 sm:p-12 text-center border border-pumpkin/30 bg-gradient-to-b from-ghostPurple/20 via-hauntedDark to-eerieSlate shadow-2xl">
            <div class="absolute -top-10 -left-10 w-40 h-40 bg-pumpkin/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-spookyGreen/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="floating inline-block mb-4">
                <span class="px-4 py-1.5 rounded-full bg-pumpkin/20 border border-pumpkin/50 text-pumpkin text-xs font-bold uppercase tracking-widest inline-flex items-center gap-2">
                    <i class="fa-solid fa-bolt"></i> Annual Halloween Live Event &bull; Oct 31, 2026
                </span>
            </div>

            <h1 class="creepster-font text-5xl sm:text-7xl lg:text-8xl text-transparent bg-clip-text bg-gradient-to-r from-pumpkin via-orange-400 to-spookyGreen mb-6 glow-orange leading-none">
                HAUNTED HARMONIES LIVE
            </h1>

            <p class="max-w-2xl mx-auto text-gray-300 text-base sm:text-lg mb-8 font-light">
                Manage live stage counts in real time! Click the <span class="text-spookyGreen font-semibold">+1 Increase Box</span> on the left to add attendees (checking or unchecking adds 1), or click the <span class="text-red-400 font-semibold">-1 Decrease Box</span> to reduce the count.
            </p>

            <!-- Countdown Timer Display -->
            <div class="grid grid-cols-4 gap-3 max-w-md mx-auto bg-black/40 p-4 rounded-2xl border border-white/10 backdrop-blur-sm">
                <div class="text-center">
                    <div id="days" class="orbitron-font text-2xl sm:text-3xl font-black text-pumpkin">00</div>
                    <div class="text-[10px] uppercase tracking-wider text-gray-400 font-semibold mt-1">Days</div>
                </div>
                <div class="text-center">
                    <div id="hours" class="orbitron-font text-2xl sm:text-3xl font-black text-spookyGreen">00</div>
                    <div class="text-[10px] uppercase tracking-wider text-gray-400 font-semibold mt-1">Hours</div>
                </div>
                <div class="text-center">
                    <div id="minutes" class="orbitron-font text-2xl sm:text-3xl font-black text-ghostPurple">00</div>
                    <div class="text-[10px] uppercase tracking-wider text-gray-400 font-semibold mt-1">Mins</div>
                </div>
                <div class="text-center">
                    <div id="seconds" class="orbitron-font text-2xl sm:text-3xl font-black text-orange-300">00</div>
                    <div class="text-[10px] uppercase tracking-wider text-gray-400 font-semibold mt-1">Secs</div>
                </div>
            </div>
        </section>

        <!-- MAIN INTERACTIVE STAGE SELECTOR SECTION -->
        <section id="stages-section" class="scroll-mt-24">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
                <div>
                    <span class="text-spookyGreen font-mono text-sm tracking-widest uppercase">&bull; Interactive Stage Pass Manager &bull;</span>
                    <h2 class="creepster-font text-4xl sm:text-5xl text-pumpkin glow-orange mt-1">
                        STAGE ACCESS SELECTOR
                    </h2>
                </div>
                <p class="text-xs text-gray-400 max-w-xs">
                    Left side boxes control attendee entry: Box 1 adds +1 on every click, Box 2 subtracts -1 from the counter on the right.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                
                <!-- STAGE LIST COLUMN (Occupies 2 columns on lg) -->
                <div class="lg:col-span-2 space-y-5">

                    <!-- STAGE 1: SKELETON STAGE -->
                    <div id="card-skeleton" class="spooky-card rounded-2xl p-5 sm:p-6 flex items-center justify-between gap-4 relative overflow-hidden group">
                        <div class="absolute left-0 top-0 bottom-0 w-2 bg-purple-600 transition-all duration-300 group-hover:w-3"></div>

                        <!-- Left Side: Two Dual Control Checkboxes (+1 and -1) -->
                        <div class="flex items-center gap-3 sm:gap-5 z-10">
                            <!-- Box 1: Increase Box (+1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-spookyGreen font-bold uppercase tracking-tighter">+1 IN</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-skeleton-inc" class="spooky-checkbox-input" onchange="incrementStage('skeleton')">
                                    <label for="check-skeleton-inc" class="spooky-checkbox-custom border-spookyGreen/80 hover:bg-spookyGreen/20" title="Increase count (+1)">
                                        <i class="fa-solid fa-plus text-spookyGreen text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Box 2: Decrease Box (-1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-red-400 font-bold uppercase tracking-tighter">-1 OUT</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-skeleton-dec" class="spooky-checkbox-input" onchange="decrementStage('skeleton')">
                                    <label for="check-skeleton-dec" class="spooky-checkbox-custom border-red-500/80 hover:bg-red-500/20" title="Decrease count (-1)">
                                        <i class="fa-solid fa-minus text-red-400 text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Stage Details -->
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-purple-950/80 border border-purple-500/40 flex items-center justify-center text-purple-400 text-2xl shadow-inner flex-shrink-0">
                                    <i class="fa-solid fa-bone"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-xl sm:text-2xl text-white group-hover:text-purple-300 transition-colors flex items-center gap-2">
                                        Skeleton Stage
                                        <span class="text-[10px] px-2 py-0.5 rounded bg-purple-900/60 text-purple-300 uppercase tracking-widest font-mono">Heavy Rock</span>
                                    </h3>
                                    <p class="text-xs sm:text-sm text-gray-400 mt-0.5">
                                        Headliner: <span class="text-gray-200 font-semibold">The Rattlin' Bones</span> &bull; 8:00 PM
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Right Side: Number Counter starting at 0 -->
                        <div class="z-10 flex items-center gap-3">
                            <div class="text-right hidden sm:block">
                                <div class="text-[10px] uppercase font-mono text-gray-400 tracking-wider">Access Count</div>
                                <div class="text-xs text-purple-400 font-medium" id="status-skeleton">Inactive</div>
                            </div>
                            <div id="counter-skeleton" class="counter-badge orbitron-font text-3xl sm:text-4xl font-black w-16 h-16 rounded-2xl bg-black/70 border border-purple-500/40 text-purple-400 flex items-center justify-center shadow-lg">
                                0
                            </div>
                        </div>
                    </div>


                    <!-- STAGE 2: BOO BAND STAGE -->
                    <div id="card-boo" class="spooky-card rounded-2xl p-5 sm:p-6 flex items-center justify-between gap-4 relative overflow-hidden group">
                        <div class="absolute left-0 top-0 bottom-0 w-2 bg-spookyGreen transition-all duration-300 group-hover:w-3"></div>

                        <!-- Left Side: Two Dual Control Checkboxes (+1 and -1) -->
                        <div class="flex items-center gap-3 sm:gap-5 z-10">
                            <!-- Box 1: Increase Box (+1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-spookyGreen font-bold uppercase tracking-tighter">+1 IN</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-boo-inc" class="spooky-checkbox-input" onchange="incrementStage('boo')">
                                    <label for="check-boo-inc" class="spooky-checkbox-custom border-spookyGreen/80 hover:bg-spookyGreen/20" title="Increase count (+1)">
                                        <i class="fa-solid fa-plus text-spookyGreen text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Box 2: Decrease Box (-1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-red-400 font-bold uppercase tracking-tighter">-1 OUT</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-boo-dec" class="spooky-checkbox-input" onchange="decrementStage('boo')">
                                    <label for="check-boo-dec" class="spooky-checkbox-custom border-red-500/80 hover:bg-red-500/20" title="Decrease count (-1)">
                                        <i class="fa-solid fa-minus text-red-400 text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Stage Details -->
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-emerald-950/80 border border-spookyGreen/40 flex items-center justify-center text-spookyGreen text-2xl shadow-inner flex-shrink-0">
                                    <i class="fa-solid fa-ghost"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-xl sm:text-2xl text-white group-hover:text-emerald-300 transition-colors flex items-center gap-2">
                                        Boo Band Stage
                                        <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-900/60 text-spookyGreen uppercase tracking-widest font-mono">Spooky Brass</span>
                                    </h3>
                                    <p class="text-xs sm:text-sm text-gray-400 mt-0.5">
                                        Headliner: <span class="text-gray-200 font-semibold">Phantom Brass Quintet</span> &bull; 9:30 PM
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Right Side: Number Counter starting at 0 -->
                        <div class="z-10 flex items-center gap-3">
                            <div class="text-right hidden sm:block">
                                <div class="text-[10px] uppercase font-mono text-gray-400 tracking-wider">Access Count</div>
                                <div class="text-xs text-spookyGreen font-medium" id="status-boo">Inactive</div>
                            </div>
                            <div id="counter-boo" class="counter-badge orbitron-font text-3xl sm:text-4xl font-black w-16 h-16 rounded-2xl bg-black/70 border border-spookyGreen/40 text-spookyGreen flex items-center justify-center shadow-lg">
                                0
                            </div>
                        </div>
                    </div>


                    <!-- STAGE 3: MONSTER MUSIC STAGE -->
                    <div id="card-monster" class="spooky-card rounded-2xl p-5 sm:p-6 flex items-center justify-between gap-4 relative overflow-hidden group">
                        <div class="absolute left-0 top-0 bottom-0 w-2 bg-pumpkin transition-all duration-300 group-hover:w-3"></div>

                        <!-- Left Side: Two Dual Control Checkboxes (+1 and -1) -->
                        <div class="flex items-center gap-3 sm:gap-5 z-10">
                            <!-- Box 1: Increase Box (+1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-spookyGreen font-bold uppercase tracking-tighter">+1 IN</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-monster-inc" class="spooky-checkbox-input" onchange="incrementStage('monster')">
                                    <label for="check-monster-inc" class="spooky-checkbox-custom border-spookyGreen/80 hover:bg-spookyGreen/20" title="Increase count (+1)">
                                        <i class="fa-solid fa-plus text-spookyGreen text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Box 2: Decrease Box (-1) -->
                            <div class="flex flex-col items-center gap-1">
                                <span class="text-[9px] font-mono text-red-400 font-bold uppercase tracking-tighter">-1 OUT</span>
                                <div class="spooky-checkbox-wrapper flex-shrink-0">
                                    <input type="checkbox" id="check-monster-dec" class="spooky-checkbox-input" onchange="decrementStage('monster')">
                                    <label for="check-monster-dec" class="spooky-checkbox-custom border-red-500/80 hover:bg-red-500/20" title="Decrease count (-1)">
                                        <i class="fa-solid fa-minus text-red-400 text-lg"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Stage Details -->
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-orange-950/80 border border-pumpkin/40 flex items-center justify-center text-pumpkin text-2xl shadow-inner flex-shrink-0">
                                    <i class="fa-solid fa-drum text-2xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-xl sm:text-2xl text-white group-hover:text-orange-300 transition-colors flex items-center gap-2">
                                        Monster Music Stage
                                        <span class="text-[10px] px-2 py-0.5 rounded bg-orange-900/60 text-pumpkin uppercase tracking-widest font-mono">EDM Synth</span>
                                    </h3>
                                    <p class="text-xs sm:text-sm text-gray-400 mt-0.5">
                                        Headliner: <span class="text-gray-200 font-semibold">Frankenstein Beats</span> &bull; 11:00 PM
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Right Side: Number Counter starting at 0 -->
                        <div class="z-10 flex items-center gap-3">
                            <div class="text-right hidden sm:block">
                                <div class="text-[10px] uppercase font-mono text-gray-400 tracking-wider">Access Count</div>
                                <div class="text-xs text-pumpkin font-medium" id="status-monster">Inactive</div>
                            </div>
                            <div id="counter-monster" class="counter-badge orbitron-font text-3xl sm:text-4xl font-black w-16 h-16 rounded-2xl bg-black/70 border border-pumpkin/40 text-pumpkin flex items-center justify-center shadow-lg">
                                0
                            </div>
                        </div>
                    </div>

                    <!-- Quick Action Controls -->
            <div class="flex items-center justify-between pt-2 px-2">
                <button onclick="addOneToAllStages()" class="text-xs font-semibold text-spookyGreen hover:underline flex items-center gap-1.5">
                    <i class="fa-solid fa-plus-circle"></i> +1 All Stages
                </button>
                <button onclick="clearAllStages()" class="text-xs font-semibold text-gray-400 hover:text-red-400 hover:underline flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left"></i> Reset All Counters To 0
                </button>
            </div>

        </div>

        <!-- RIGHT SIDE WIDGET SUMMARY PANEL -->
        <div class="lg:col-span-1">
                    <div class="spooky-card rounded-3xl p-6 border border-pumpkin/40 relative sticky top-28 bg-hauntedDark/90">
                        <div class="flex items-center justify-between mb-4 pb-4 border-b border-white/10">
                            <h3 class="orbitron-font text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-sliders text-pumpkin"></i> Live Summary
                            </h3>
                            <span class="px-2.5 py-1 rounded-full bg-pumpkin/20 text-pumpkin border border-pumpkin/30 text-xs font-mono font-bold">
                                REALTIME
                            </span>
                        </div>

                        <!-- Total Active Stages Count Badge -->
                        <div class="bg-black/60 rounded-2xl p-5 text-center mb-6 border border-white/10 relative overflow-hidden">
                            <div class="text-xs text-gray-400 uppercase font-mono tracking-widest mb-1">Total Active Stages Selected</div>
                            <div id="total-selected-count" class="orbitron-font text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-pumpkin via-spookyGreen to-ghostPurple my-2 transition-all duration-300">
                                0
                            </div>
                            <div class="text-xs text-gray-400 font-medium" id="total-count-label">
                                No stages selected yet
                            </div>
                        </div>

                        <!-- Selected Stages Checklist Summary -->
                        <div class="space-y-3 mb-6">
                            <h4 class="text-xs uppercase font-mono text-gray-400 tracking-wider">Included In Pass:</h4>
                            
                            <div id="summary-skeleton" class="flex items-center justify-between p-3 rounded-xl bg-white/5 opacity-40 transition-all">
                                <span class="text-sm font-semibold text-gray-300 flex items-center gap-2">
                                    <i class="fa-solid fa-bone text-purple-400"></i> Skeleton Stage
                                </span>
                                <span class="summary-badge text-xs px-2 py-0.5 rounded font-mono bg-gray-800 text-gray-500">Unselected</span>
                            </div>

                            <div id="summary-boo" class="flex items-center justify-between p-3 rounded-xl bg-white/5 opacity-40 transition-all">
                                <span class="text-sm font-semibold text-gray-300 flex items-center gap-2">
                                    <i class="fa-solid fa-ghost text-spookyGreen"></i> Boo Band
                                </span>
                                <span class="summary-badge text-xs px-2 py-0.5 rounded font-mono bg-gray-800 text-gray-500">Unselected</span>
                            </div>

                            <div id="summary-monster" class="flex items-center justify-between p-3 rounded-xl bg-white/5 opacity-40 transition-all">
                                <span class="text-sm font-semibold text-gray-300 flex items-center gap-2">
