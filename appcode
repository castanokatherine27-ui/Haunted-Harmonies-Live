    <script>
        // State management for stage selection counters
        const stageState = {
            skeleton: { name: 'Skeleton Stage', count: 0, color: 'purple' },
            boo: { name: 'Boo Band Stage', count: 0, color: 'spookyGreen' },
            monster: { name: 'Monster Music Stage', count: 0, color: 'pumpkin' }
        };

        let audioCtx = null;
        let isAudioEnabled = false;

        function initAudio() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) audioCtx = new AudioContext();
            }
        }

        function toggleAudio() {
            initAudio();
            isAudioEnabled = !isAudioEnabled;
            const icon = document.getElementById('soundIcon');
            const text = document.getElementById('soundText');
            const btn = document.getElementById('soundToggleBtn');

            if (isAudioEnabled) {
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                icon.className = 'fa-solid fa-volume-high text-sm';
                text.innerText = 'Spooky Sounds On';
                btn.classList.add('border-spookyGreen', 'text-spookyGreen', 'bg-spookyGreen/20');
                btn.classList.remove('border-pumpkin/40', 'text-pumpkin', 'bg-pumpkin/10');
                playSpookySound('select');
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-sm';
                text.innerText = 'Spooky Sounds Off';
                btn.classList.remove('border-spookyGreen', 'text-spookyGreen', 'bg-spookyGreen/20');
                btn.classList.add('border-pumpkin/40', 'text-pumpkin', 'bg-pumpkin/10');
            }
        }

        // Play Synthesized Sounds without external assets
        function playSpookySound(type) {
            if (!isAudioEnabled || !audioCtx) return;

            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'select') {
                    // Creepy pitch slide up when checkbox is selected (+1)
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(160, now);
                    osc.frequency.exponentialRampToValueAtTime(480, now + 0.25);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'unselect') {
                    // Low eerie pitch slide down when checkbox is unselected (-1)
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(320, now);
                    osc.frequency.exponentialRampToValueAtTime(110, now + 0.25);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                }
            } catch(e) {
                console.log('Audio playback error:', e);
            }
        }

        /**
         * Increments the specified stage count by +1 on every click/interaction
         */
        function incrementStage(stageKey) {
            const stage = stageState[stageKey];
            if (!stage) return;

            stage.count += 1;
            playSpookySound('select');

            updateStageUI(stageKey);
            updateTotalSummary();
        }

        /**
         * Decrements the specified stage count by -1 using the dedicated second decrease box
         */
        function decrementStage(stageKey) {
            const stage = stageState[stageKey];
            if (!stage) return;

            stage.count = Math.max(0, stage.count - 1);
            playSpookySound('unselect');

            updateStageUI(stageKey);
            updateTotalSummary();
        }

        // Update UI for specific stage card and counter on right side
        function updateStageUI(stageKey) {
            const stage = stageState[stageKey];
            const counterEl = document.getElementById(`counter-${stageKey}`);
            const statusEl = document.getElementById(`status-${stageKey}`);
            const summaryEl = document.getElementById(`summary-${stageKey}`);
            const cardEl = document.getElementById(`card-${stageKey}`);

            if (!counterEl) return;

            // Update Counter Number on the right side
            counterEl.innerText = stage.count;

            // Trigger visual bump animation on counter
            counterEl.classList.add('counter-bump');
            setTimeout(() => counterEl.classList.remove('counter-bump'), 200);

            // Update status text & card styling based on count
            if (stage.count > 0) {
                statusEl.innerText = `Active (${stage.count})`;
                statusEl.className = 'text-xs font-bold text-spookyGreen';
                
                // Highlight card border
                cardEl.classList.add('border-spookyGreen/60', 'bg-white/5');
                
                // Update summary row on right sidebar
                if (summaryEl) {
                    summaryEl.classList.remove('opacity-40');
                    summaryEl.classList.add('bg-white/10', 'border', 'border-spookyGreen/30');
                    const badge = summaryEl.querySelector('.summary-badge');
                    if (badge) {
                        badge.innerText = `Count: ${stage.count}`;
                        badge.className = 'summary-badge text-xs px-2 py-0.5 rounded font-mono bg-spookyGreen/20 text-spookyGreen font-bold';
                    }
                }
            } else {
                statusEl.innerText = 'Inactive';
                statusEl.className = 'text-xs text-gray-500 font-medium';
                
                // Remove highlight
                cardEl.classList.remove('border-spookyGreen/60', 'bg-white/5');

                // Reset summary row on right sidebar
                if (summaryEl) {
                    summaryEl.classList.add('opacity-40');
                    summaryEl.classList.remove('bg-white/10', 'border', 'border-spookyGreen/30');
                    const badge = summaryEl.querySelector('.summary-badge');
                    if (badge) {
                        badge.innerText = 'Count: 0';
                        badge.className = 'summary-badge text-xs px-2 py-0.5 rounded font-mono bg-gray-800 text-gray-500';
                    }
                }
            }
        }

        function updateTotalSummary() {
            const total = Object.values(stageState).reduce((acc, stage) => acc + stage.count, 0);
            
            const totalCountEl = document.getElementById('total-selected-count');
            const totalLabelEl = document.getElementById('total-count-label');
            const passBtn = document.getElementById('generatePassBtn');

            if (totalCountEl) {
                totalCountEl.innerText = total;
                totalCountEl.classList.add('counter-bump');
                setTimeout(() => totalCountEl.classList.remove('counter-bump'), 200);
            }

            if (totalLabelEl) {
                if (total === 0) {
                    totalLabelEl.innerText = 'No attendees checked in';
                } else if (total === 1) {
                    totalLabelEl.innerText = '1 Total Attendee Checked In';
                } else {
                    totalLabelEl.innerText = `${total} Total Attendees Checked In`;
                }
            }

            // Enable/disable claim button
            if (passBtn) {
                if (total > 0) {
                    passBtn.disabled = false;
                    passBtn.className = "w-full py-3.5 px-4 rounded-xl font-bold text-sm tracking-wider uppercase transition-all flex items-center justify-center gap-2 bg-gradient-to-r from-pumpkin to-orange-500 hover:from-orange-500 hover:to-pumpkin text-black cursor-pointer shadow-lg shadow-pumpkin/20";
                } else {
                    passBtn.disabled = true;
                    passBtn.className = "w-full py-3.5 px-4 rounded-xl font-bold text-sm tracking-wider uppercase transition-all flex items-center justify-center gap-2 bg-gray-800 text-gray-500 cursor-not-allowed";
                }
            }
        }

        // Add 1 to all stages
        function addOneToAllStages() {
            ['skeleton', 'boo', 'monster'].forEach(key => {
                incrementStage(key);
            });
        }

        // Reset all stage counts to zero
        function clearAllStages() {
            ['skeleton', 'boo', 'monster'].forEach(key => {
                stageState[key].count = 0;
                updateStageUI(key);
            });
            updateTotalSummary();
        }

        // Concert Pass Modal Functions
        function openPassModal() {
            const modal = document.getElementById('passModal');
            const modalTotal = document.getElementById('modalTotalStages');
            const modalList = document.getElementById('modalStageList');
            const modalId = document.getElementById('modalPassId');

            const total = Object.values(stageState).reduce((acc, stage) => acc + stage.count, 0);
            if (total === 0) return;

            modalTotal.innerText = `${total} Active Stage${total > 1 ? 's' : ''}`;
            modalId.innerText = `#HAUNT-${Math.floor(1000 + Math.random() * 9000)}`;

            modalList.innerHTML = '';
            Object.keys(stageState).forEach(key => {
                const stage = stageState[key];
                if (stage.count > 0) {
                    const li = document.createElement('li');
                    li.className = "flex items-center gap-2 text-spookyGreen";
                    li.innerHTML = `<i class="fa-solid fa-check text-xs"></i> ${stage.name} (${stage.count} Pass)`;
                    modalList.appendChild(li);
                }
            });

            modal.classList.remove('hidden');
        }

        function closePassModal() {
            document.getElementById('passModal').classList.add('hidden');
        }

        function copyPassCode() {
            const code = `SPOOKY-2026-PASS-${Math.floor(10000 + Math.random() * 90000)}`;
            
            // Clipboard standard fallback
            const el = document.createElement('textarea');
            el.value = code;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            alertMessage('Pass Confirmation Copied!');
        }

        // Custom notification replacing standard alert
        function alertMessage(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 bg-spookyGreen text-black font-extrabold px-5 py-3 rounded-xl shadow-2xl flex items-center gap-2 text-sm border border-black animate-bounce';
            toast.innerHTML = `<i class="fa-solid fa-ghost"></i> ${msg}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2800);
        }

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Countdown Clock
        function updateCountdown() {
            const now = new Date();
            let target = new Date(now.getFullYear(), 9, 31, 20, 0, 0); // Oct 31, 8:00 PM
            if (now > target) {
                target = new Date(now.getFullYear() + 1, 9, 31, 20, 0, 0);
            }

            const diff = target - now;

            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const m = Math.floor((diff / 1000 / 60) % 60);
            const s = Math.floor((diff / 1000) % 60);

            document.getElementById('days').innerText = String(d).padStart(2, '0');
            document.getElementById('hours').innerText = String(h).padStart(2, '0');
            document.getElementById('minutes').innerText = String(m).padStart(2, '0');
            document.getElementById('seconds').innerText = String(s).padStart(2, '0');
        }

        // Canvas Ambient Fog Animation
        function initFogEffect() {
            const canvas = document.getElementById('fogCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            const particles = Array.from({ length: 25 }, () => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                radius: Math.random() * 120 + 80,
                vx: (Math.random() - 0.5) * 0.4,
                vy: (Math.random() - 0.5) * 0.4,
                alpha: Math.random() * 0.15 + 0.05
            }));

            function animateFog() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < -p.radius) p.x = canvas.width + p.radius;
                    if (p.x > canvas.width + p.radius) p.x = -p.radius;
                    if (p.y < -p.radius) p.y = canvas.height + p.radius;
                    if (p.y > canvas.height + p.radius) p.y = -p.radius;

                    const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius);
                    grad.addColorStop(0, `rgba(139, 0, 255, ${p.alpha})`);
                    grad.addColorStop(0.5, `rgba(255, 107, 0, ${p.alpha * 0.5})`);
                    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                });

                requestAnimationFrame(animateFog);
            }

            animateFog();
        }

        window.onload = function() {
            updateCountdown();
            setInterval(updateCountdown, 1000);
            initFogEffect();
            updateTotalSummary();
        };
    </script>
